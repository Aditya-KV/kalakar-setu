# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kalakarsetu
# For local dev with SQLite:
# DATABASE_URL=sqlite+aiosqlite:///./kalakarsetu.db

# JWT
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# OTP
OTP_EXPIRE_MINUTES=5
OTP_COOLDOWN_SECONDS=60
OTP_MAX_REQUESTS_PER_WINDOW=3
OTP_RATE_WINDOW_MINUTES=5
OTP_MAX_VERIFY_ATTEMPTS=5

# SMS Provider (mock | twilio)
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Firebase Phone Authentication — must match the frontend's
# EXPO_PUBLIC_FIREBASE_PROJECT_ID. No service account key needed.
FIREBASE_PROJECT_ID=

# CORS
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,exp://localhost:8081

# App
APP_NAME=Kalakar Setu
DEBUG=true
