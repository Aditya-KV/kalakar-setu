# Backend API base URL. Defaults to http://10.0.2.2:8000/api/v1 on Android
# emulator or http://localhost:8000/api/v1 elsewhere if unset.
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1

# Firebase Phone Authentication uses the native SDK (@react-native-firebase),
# which reads its config from google-services.json (Android) / GoogleService-Info.plist
# (iOS) at build time — see app.json's "googleServicesFile" field. No env vars needed here.
